# 复制到 /etc/minimall/minimall.env，替换示例值后设为 600 权限。
# systemd 的 EnvironmentFile 不是 shell 脚本：每行写 KEY=VALUE，不要写 export。
DB_URL=jdbc:mysql://127.0.0.1:3306/minimall?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=minimall_app
DB_PASSWORD=replace-with-a-unique-database-password
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-unique-redis-password
MQ_HOST=127.0.0.1
MQ_PORT=5672
MQ_USERNAME=minimall_app
MQ_PASSWORD=replace-with-a-unique-rabbitmq-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-admin-password-at-least-12-characters
USER_USERNAME=user
USER_PASSWORD=replace-with-a-unique-user-password-at-least-12-characters
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-utf8-bytes
WS_ALLOWED_ORIGINS=https://mall.example.com
