[Unit]
Description=MiniMall Spring Boot service
After=network-online.target mysql.service redis-server.service rabbitmq-server.service
Wants=network-online.target

[Service]
Type=simple
User=minimall
Group=minimall
WorkingDirectory=/opt/minimall
EnvironmentFile=/etc/minimall/minimall.env
# 使用 prod profile 后，Java 只在 127.0.0.1:8080 监听。
ExecStart=/usr/bin/java -jar /opt/minimall/minimall-server.jar --spring.profiles.active=prod
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
