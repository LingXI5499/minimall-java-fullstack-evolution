<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lingxi.minimall.mapper.CategoryMapper">
  <!-- 分类按 ID 排列，供前端筛选和编辑表单使用。 -->
  <select id="selectAll" resultType="com.lingxi.minimall.entity.Category">
    SELECT id, name FROM category ORDER BY id
  </select>
  <select id="selectById" resultType="com.lingxi.minimall.entity.Category">
    SELECT id, name FROM category WHERE id = #{id}
  </select>
</mapper>
