<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lingxi.minimall.mapper.OrderNotificationMapper">
  <!-- order_id 唯一：RabbitMQ 至少一次投递时，重复消息影响行数为 0。 -->
  <insert id="insertIfAbsent">
    INSERT IGNORE INTO order_notification (order_id, message) VALUES (#{orderId}, #{message})
  </insert>
</mapper>
